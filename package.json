{
	"name": "notes",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "biome check .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"format": "biome check --write .",
		"new:note": "node scripts/new-note.ts",
		"new:widget": "node scripts/new-widget.ts"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource/stix-two-math": "5.3.0",
		"foundationui": "https://github.com/SnowballSH/foundationui/releases/download/v0.5.5/foundationui-0.5.5.tgz"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "^26.6.6",
		"parse5": "8.1.1",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	},
	"packageManager": "pnpm@12.16.1"
}
